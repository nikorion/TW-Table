title: $:/plugins/nikorion/table/language/lingo
tags: $:/tags/Global

<!-- Only one string needs this (the settings tab caption), so no -text/-value variants
     are provided. The sibling TW-Dynamic-Table plugin has its own `dyntable-lingo`. -->
\procedure table-lingo(title)
\whitespace trim
<$let _lang={{{ [[$:/language]get[text]get[name]else[en-GB]] }}}>
<$transclude $tiddler={{{ [[$:/plugins/nikorion/table/language/]addsuffix<_lang>addsuffix[/]addsuffix<title>] }}}>
<$transclude $tiddler={{{ [[$:/plugins/nikorion/table/language/en-GB/]addsuffix<title>] }}}/>
</$transclude>
</$let>
\end
