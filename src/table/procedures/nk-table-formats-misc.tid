title: $:/plugins/nikorion/table/procedures/nk-table-formats-misc
type: text/vnd.tiddlywiki

\procedure email() <a class="tc-tiddlylink-external" href=`mailto:$(entry)$` rel="noopener noreferrer" target="_blank"><<text>></a>

\procedure rate()
<$list filter="[<entry>split[]match[*]]" variable=ignore>
<span class="nk-table-star"><$transclude $tiddler="$:/core/images/star-filled" /></span>
</$list>
\end rate

<!-- these procedures are used by the table macro to display entries -->
