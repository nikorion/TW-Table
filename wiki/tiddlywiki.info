{
  "description": "TW-Table development wiki",
  "plugins": [
    "tiddlywiki/filesystem",
    "tiddlywiki/tiddlyweb",
    "nikorion/table",
    "nikorion/tiny-bootstrap",
    "nikorion/detect-language"
  ],
  "themes": [
    "tiddlywiki/vanilla"
  ],
  "languages": [
    "fr-FR"
  ],
  "pluginPath": ["../src", "../../TW-Tiny-Bootstrap/src"],
  "config": {
    "retain-original-tiddler-path": true
  },
  "build": {
    "plugin-json": [
      "--output", "dist",
      "--render", "$:/core/templates/exporters/JsonFile", "TW-Table-Plugin.json", "text/plain", "", "exportFilter", "[[$:/plugins/nikorion/table]]"
    ],
    "html": [
      "--output", "docs",
      "--rendertiddler", "$:/core/save/all", "TW-Table-Wiki.html", "text/plain", "",
      "publishFilter", "-[[$:/config/SyncFilter]] -[[$:/config/FileSystemPaths]] -[[$:/config/OriginalTiddlerPaths]]"
    ]
  }
}
